[debug] [2026-03-03T06:59:13.326Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/storecheck-6fdc8/rulesets {"name":"projects/storecheck-6fdc8/rulesets/6e1f8a70-ef49-4693-8e6b-baa9d14ad8a5","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // =========================\n    // Helpers\n    // =========================\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function myUid() {\n      return request.auth.uid;\n    }\n\n    function isSelf(uid) {\n      return signedIn() && uid == myUid();\n    }\n\n    function myUserPath() {\n      return /databases/$(database)/documents/users/$(myUid());\n    }\n\n    function myUserExists() {\n      return signedIn() && exists(myUserPath());\n    }\n\n    function myUserData() {\n      return get(myUserPath()).data;\n    }\n\n    function myUserIsActive() {\n      return myUserExists() && myUserData().isActive == true;\n    }\n\n    function myRole() {\n      return myUserExists() ? myUserData().role : null;\n    }\n\n    function activeManager() {\n      return myUserIsActive() && myRole() == \"manager\";\n    }\n\n    function isManagerStoreDoc(data) {\n      return (data.managerId is string) && (data.managerId == myUid());\n    }\n\n    function isStoreMember(storeId) {\n      return signedIn()\n        && (storeId is string)\n        && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(myUid()));\n    }\n\n    function employeeAssignedToStore(storeId) {\n      return signedIn()\n        && (storeId is string)\n        && exists(/databases/$(database)/documents/employeeStores/$(myUid())/stores/$(storeId));\n    }\n\n    function canReadStore(storeId, data) {\n      return signedIn()\n        && (\n          isManagerStoreDoc(data)\n          || isStoreMember(storeId)\n          || employeeAssignedToStore(storeId)\n        );\n    }\n\n    // ✅ NEW (minimal): manager owns this storeId\n    function isStoreManager(storeId) {\n      return activeManager()\n        && (storeId is string)\n        && exists(/databases/$(database)/documents/stores/$(storeId))\n        && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid();\n    }\n\n    function managerCanUpdateMemberProfile(storeId) {\n      return activeManager()\n        && isStoreManager(storeId)\n        && request.resource.data.userId == resource.data.userId\n        && request.resource.data.storeId == resource.data.storeId\n        && request.resource.data.joinedAt == resource.data.joinedAt\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly([\n            \"employeeName\",\n            \"employeeEmail\",\n            \"displayName\",\n            \"name\",\n            \"isActive\",\n            \"hourlyRate\",\n            \"updatedAt\"\n          ]);\n    }\n\n    // ✅ NEW (minimal, required): manager can ONLY edit time fields on a checkin\n    function managerEditsTimesOnly() {\n      return activeManager()\n        && (resource.data.storeId is string)\n        && isStoreManager(resource.data.storeId)\n        // lock identity fields\n        && request.resource.data.employeeId == resource.data.employeeId\n        && request.resource.data.storeId == resource.data.storeId\n        && request.resource.data.createdAt == resource.data.createdAt\n        // only allow these fields to change\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly([\"checkInTime\", \"checkOutTime\", \"updatedAt\"]);\n    }\n\n    // ==================================\n    // ✅ NEW (required): Deletion Requests\n    // deletionRequests/{uid}\n    // ==================================\n    match /deletionRequests/{uid} {\n      // user can create/update ONLY their own request\n      allow create: if isSelf(uid);\n      allow update: if isSelf(uid);\n\n      // optional but safe for debugging\n      allow get: if isSelf(uid);\n      allow list: if false;\n\n      // keep deletions backend-only\n      allow delete: if false;\n    }\n\n    // ==================================\n    // USERS\n    // ==================================\n    match /users/{uid} {\n      allow get: if isSelf(uid);\n      allow list: if false;\n\n      allow create: if isSelf(uid) && request.resource.data.role == \"employee\";\n\n      allow update: if isSelf(uid)\n        && request.resource.data.role == resource.data.role\n        && request.resource.data.createdAt == resource.data.createdAt\n        && request.resource.data.assignedStoreIds == resource.data.assignedStoreIds;\n\n      allow delete: if isSelf(uid);\n    }\n\n    // ==================================\n    // QUERY-SAFE MIRRORS (stores)\n    // ==================================\n    match /managerStores/{managerUid}/stores/{storeId} {\n      allow get, list: if request.auth != null\n        && request.auth.uid == managerUid\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == \"manager\"\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;\n\n      allow create, update: if request.auth != null\n        && request.auth.uid == managerUid\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == \"manager\"\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true\n        && request.resource.data.managerId == request.auth.uid\n        && request.resource.data.storeId == storeId;\n\n      allow delete: if request.auth != null\n        && request.auth.uid == managerUid\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == \"manager\"\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;\n    }\n\n    match /employeeStores/{employeeUid}/stores/{storeId} {\n      allow get, list: if isSelf(employeeUid) && myUserIsActive();\n\n      allow create, update: if isSelf(employeeUid)\n        && myUserIsActive()\n        && request.resource.data.employeeId == myUid()\n        && request.resource.data.storeId == storeId;\n\n      allow delete: if false;\n    }\n\n    // ==================================\n    // STORES ROOT\n    // ==================================\n    match /stores/{storeId} {\n      allow get: if canReadStore(storeId, resource.data);\n      allow list: if false;\n\n      allow create: if activeManager()\n        && request.resource.data.managerId == myUid()\n        && request.resource.data.isActive == true;\n\n      allow update: if activeManager()\n        && resource.data.managerId == myUid()\n        && request.resource.data.managerId == resource.data.managerId;\n\n      allow delete: if activeManager()\n        && resource.data.managerId == myUid();\n\n      match /members/{uid} {\n        allow get: if isSelf(uid)\n          || (activeManager()\n              && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid());\n\n        allow list: if activeManager()\n          && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid();\n\n        allow create: if isSelf(uid)\n          && request.resource.id == myUid()\n          && request.resource.data.userId == myUid()\n          && request.resource.data.storeId == storeId;\n\n        allow update: if isSelf(uid)\n          && request.resource.data.userId == resource.data.userId\n          && request.resource.data.storeId == resource.data.storeId\n          && request.resource.data.joinedAt == resource.data.joinedAt;\n        allow update: if managerCanUpdateMemberProfile(storeId);\n\n        allow delete: if false;\n      }\n    }\n\n    // ==================================\n    // CHECKINS ROOT\n    // ==================================\n    match /checkins/{checkinId} {\n\n      function storeDocSafe(storeId) {\n        return (storeId is string)\n          && exists(/databases/$(database)/documents/stores/$(storeId));\n      }\n\n      allow get: if signedIn() && (\n        resource.data.employeeId == myUid()\n        || (\n          activeManager()\n          && (resource.data.storeId is string)\n          && storeDocSafe(resource.data.storeId)\n          && canReadStore(\n            resource.data.storeId,\n            get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data\n          )\n        )\n      );\n\n      allow list: if false;\n\n      allow create: if signedIn()\n        && request.resource.data.employeeId == myUid()\n        && (request.resource.data.storeId is string)\n        && (\n          employeeAssignedToStore(request.resource.data.storeId)\n          || isStoreMember(request.resource.data.storeId)\n        );\n\n      // ✅ CHANGE (minimal): employee can update their own (existing rules)\n      // ✅ ADD (minimal): manager can update ONLY time fields (for stores they own)\n      allow update: if (\n          signedIn()\n          && resource.data.employeeId == myUid()\n          && request.resource.data.employeeId == resource.data.employeeId\n          && request.resource.data.storeId == resource.data.storeId\n          && request.resource.data.checkInTime == resource.data.checkInTime\n          && request.resource.data.createdAt == resource.data.createdAt\n        )\n        || managerEditsTimesOnly();\n\n      // ✅ FIX (minimal): manager can delete ONLY if they own the store for this checkin\n      // (keeps employee delete working)\n      allow delete: if (signedIn() && resource.data.employeeId == myUid())\n        || (isStoreManager(resource.data.storeId));\n    }\n\n    // ==================================\n    // EMPLOYEE CHECKIN MIRROR\n    // employeeCheckins/{employeeUid}/checkins/{checkinId}\n    // ==================================\n    match /employeeCheckins/{employeeUid}/checkins/{checkinId} {\n      allow get, list: if isSelf(employeeUid) && myUserIsActive();\n\n      allow create: if isSelf(employeeUid)\n        && request.resource.data.employeeId == myUid()\n        && (request.resource.data.storeId is string)\n        && (isStoreMember(request.resource.data.storeId) || employeeAssignedToStore(request.resource.data.storeId));\n\n      // ✅ CHANGE (minimal): allow manager time edits on employee mirror too\n      allow update: if (\n          isSelf(employeeUid)\n          && resource.data.employeeId == myUid()\n          && request.resource.data.employeeId == resource.data.employeeId\n          && request.resource.data.storeId == resource.data.storeId\n          && request.resource.data.checkInTime == resource.data.checkInTime\n          && request.resource.data.createdAt == resource.data.createdAt\n        )\n        || (\n          // manager edits times only, for stores they own\n          activeManager()\n          && (resource.data.storeId is string)\n          && isStoreManager(resource.data.storeId)\n          && request.resource.data.employeeId == resource.data.employeeId\n          && request.resource.data.storeId == resource.data.storeId\n          && request.resource.data.createdAt == resource.data.createdAt\n          && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly([\"checkInTime\", \"checkOutTime\", \"updatedAt\"])\n        );\n\n      // ✅ FIX (minimal): allow manager to delete employee mirror ONLY for their store\n      allow delete: if (isSelf(employeeUid) && myUserIsActive())\n        || (activeManager()\n            && (resource.data.storeId is string)\n            && isStoreManager(resource.data.storeId));\n    }\n\n    // ==================================\n    // MANAGER CHECKIN MIRROR\n    // managerCheckins/{managerUid}/stores/{storeId}/checkins/{checkinId}\n    // ==================================\n    match /managerCheckins/{managerUid}/stores/{storeId}/checkins/{checkinId} {\n\n      function storeExists(storeId) {\n        return (storeId is string) && exists(/databases/$(database)/documents/stores/$(storeId));\n      }\n\n      function storeManagerMatches(managerUid, storeId) {\n        return storeExists(storeId)\n          && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == managerUid;\n      }\n\n      allow get, list: if activeManager()\n        && myUid() == managerUid\n        && storeManagerMatches(managerUid, storeId);\n\n      // (keeping your existing create/update rule as-is)\n      allow create, update: if signedIn()\n        && request.resource.data.employeeId == myUid()\n        && (request.resource.data.storeId is string)\n        && request.resource.data.storeId == storeId\n        && storeManagerMatches(managerUid, storeId)\n        && (isStoreMember(storeId) || employeeAssignedToStore(storeId));\n\n      // ✅ ADD (minimal): manager can update ONLY time fields in their mirror docs\n      allow update: if (\n          activeManager()\n          && myUid() == managerUid\n          && storeManagerMatches(managerUid, storeId)\n          && request.resource.data.employeeId == resource.data.employeeId\n          && request.resource.data.storeId == resource.data.storeId\n          && request.resource.data.createdAt == resource.data.createdAt\n          && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly([\"checkInTime\", \"checkOutTime\", \"updatedAt\"])\n        )\n        || (\n          signedIn()\n          && request.resource.data.employeeId == myUid()\n          && (request.resource.data.storeId is string)\n          && request.resource.data.storeId == storeId\n          && storeManagerMatches(managerUid, storeId)\n          && (isStoreMember(storeId) || employeeAssignedToStore(storeId))\n        );\n\n      // ✅ FIX (minimal): manager can delete their mirror docs (and employee can delete their own)\n      allow delete: if (activeManager() && myUid() == managerUid)\n        || (signedIn() && resource.data.employeeId == myUid());\n    }\n  }\n}\n","name":"firebase/firestore.rules"}]},"createTime":"2026-03-03T06:59:13.255503Z","metadata":{"services":["cloud.firestore"]}}
