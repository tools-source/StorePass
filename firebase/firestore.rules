rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(myUid());
    }

    function myUserData() {
      return get(myUserPath()).data;
    }

    function myUserExists() {
      return signedIn() && exists(myUserPath());
    }

    function myUserIsActive() {
      return myUserExists() && myUserData().isActive == true;
    }

    function myRole() {
      return myUserExists() ? myUserData().role : null;
    }

    function activeManager() {
      return myUserIsActive() && myRole() == "manager";
    }

    function activeEmployee() {
      return myUserIsActive() && myRole() == "employee";
    }

    function isSelf(uid) {
      return signedIn() && uid == myUid();
    }

    function isManagerStoreDoc(data) {
      return data.managerId is string && data.managerId == myUid();
    }

    function isStoreMember(storeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(myUid()));
    }

    function employeeAssignedToStore(storeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/employeeStores/$(myUid())/stores/$(storeId));
    }

    function assignedViaUserProfile(storeId) {
      return myUserExists()
        && myUserData().assignedStoreIds is list
        && myUserData().assignedStoreIds.hasAny([storeId]);
    }

    function employeeCanCheckInToStore(storeId) {
      return isStoreMember(storeId)
        || employeeAssignedToStore(storeId)
        || assignedViaUserProfile(storeId);
    }

    function canReadStore(storeId, data) {
      return signedIn() && (
        isManagerStoreDoc(data)
        || isStoreMember(storeId)
        || employeeAssignedToStore(storeId)
      );
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || activeManager();
      allow list: if false;
      allow create: if isSelf(uid) && request.resource.data.role == "employee";
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.assignedStoreIds == resource.data.assignedStoreIds;
      allow delete: if isSelf(uid);
    }

    // Query-safe manager store listing path.
    match /managerStores/{managerUid}/stores/{storeId} {
      allow get, list: if isSelf(managerUid) && activeManager();
      allow create, update, delete: if isSelf(managerUid)
        && activeManager()
        && request.resource.data.managerId == myUid()
        && request.resource.data.storeId == storeId;
    }

    // Query-safe employee-assigned stores listing path.
    match /employeeStores/{employeeUid}/stores/{storeId} {
      allow get, list: if isSelf(employeeUid) && myUserIsActive();
      allow create, update: if isSelf(employeeUid)
        && myUserIsActive()
        && request.resource.data.employeeId == myUid()
        && request.resource.data.storeId == storeId;
      allow delete: if false;
    }


    match /employeeCheckins/{employeeUid}/checkins/{checkinId} {
      allow get, list: if isSelf(employeeUid) && myUserIsActive();

      allow create: if request.auth != null
        && request.auth.uid == employeeUid
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.storeId is string;

      allow update, delete: if false;
    }

    match /managerCheckins/{managerUid}/stores/{storeId}/checkins/{checkinId} {
      allow get, list: if isSelf(managerUid)
        && activeManager()
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == managerUid;

      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "employee"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.storeId == storeId
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == managerUid;

      allow update, delete: if false;
    }

    match /stores/{storeId} {
      allow get: if canReadStore(storeId, resource.data);
      allow list: if false;
      allow create: if activeManager()
        && request.resource.data.managerId == myUid()
        && request.resource.data.isActive == true;
      allow update: if activeManager()
        && resource.data.managerId == myUid()
        && request.resource.data.managerId == resource.data.managerId;
      allow delete: if activeManager() && resource.data.managerId == myUid();

      match /members/{uid} {
        allow get: if isSelf(uid)
          || (activeManager() && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid());
        allow list: if activeManager()
          && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid();
        allow create: if isSelf(uid)
          && request.resource.id == myUid()
          && request.resource.data.userId == myUid()
          && request.resource.data.storeId == storeId;
        allow update: if isSelf(uid)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if false;
      }
    }

    function employeeCheckinHistoryQueryAllowed() {
      return request.query.where("employeeId", "==", myUid())
        && request.query.orderBy("checkInTime", "desc")
        && request.query.limit != null
        && request.query.limit <= 100;
    }

    match /checkins/{checkinId} {
      allow get: if signedIn() && (
        resource.data.employeeId == myUid()
        || (activeManager() && canReadStore(resource.data.storeId, get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data))
      );
      allow list: if (signedIn() && employeeCheckinHistoryQueryAllowed())
        || activeManager();
      allow create: if signedIn()
        && request.resource.data.employeeId == myUid()
        && employeeCanCheckInToStore(request.resource.data.storeId);
      allow update: if false;
      allow delete: if activeManager();
    }
  }
}
