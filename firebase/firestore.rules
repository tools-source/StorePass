rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helpers
    // =========================
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function isSelf(uid) {
      return signedIn() && uid == myUid();
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(myUid());
    }

    function myUserExists() {
      return signedIn() && exists(myUserPath());
    }

    function myUserData() {
      return get(myUserPath()).data;
    }

    function myUserIsActive() {
      return myUserExists() && myUserData().isActive == true;
    }

    function myRole() {
      return myUserExists() ? myUserData().role : null;
    }

    function activeManager() {
      return myUserIsActive() && myRole() == "manager";
    }

    function activeEmployee() {
      return myUserIsActive() && myRole() == "employee";
    }

    function isManagerStoreDoc(data) {
      return (data.managerId is string) && (data.managerId == myUid());
    }

    function isStoreMember(storeId) {
      return signedIn()
        && (storeId is string)
        && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(myUid()));
    }

    function employeeAssignedToStore(storeId) {
      return signedIn()
        && (storeId is string)
        && exists(/databases/$(database)/documents/employeeStores/$(myUid())/stores/$(storeId));
    }

    function canReadStore(storeId, data) {
      return signedIn()
        && (
          isManagerStoreDoc(data)
          || isStoreMember(storeId)
          || employeeAssignedToStore(storeId)
        );
    }

    // ✅ NEW (minimal): manager owns this storeId
    function isStoreManager(storeId) {
      return activeManager()
        && (storeId is string)
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid();
    }

    // ✅ NEW (minimal, required): manager can ONLY edit time fields on a checkin
    function managerEditsTimesOnly() {
      return activeManager()
        && (resource.data.storeId is string)
        && isStoreManager(resource.data.storeId)
        // lock identity fields
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.createdAt == resource.data.createdAt
        // only allow these fields to change
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["checkInTime", "checkOutTime", "updatedAt"]);
    }

    // ==================================
    // ✅ NEW (required): Deletion Requests
    // deletionRequests/{uid}
    // ==================================
    match /deletionRequests/{uid} {
      // user can create/update ONLY their own request
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);

      // optional but safe for debugging
      allow get: if isSelf(uid);
      allow list: if false;

      // keep deletions backend-only
      allow delete: if false;
    }

    // ==================================
    // USERS
    // ==================================
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      allow create: if isSelf(uid) && request.resource.data.role == "employee";

      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.assignedStoreIds == resource.data.assignedStoreIds;

      allow delete: if isSelf(uid);
    }

    // ==================================
    // QUERY-SAFE MIRRORS (stores)
    // ==================================
    match /managerStores/{managerUid}/stores/{storeId} {
      allow get, list: if request.auth != null
        && request.auth.uid == managerUid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;

      allow create, update: if request.auth != null
        && request.auth.uid == managerUid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.storeId == storeId;

      allow delete: if request.auth != null
        && request.auth.uid == managerUid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "manager"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    match /employeeStores/{employeeUid}/stores/{storeId} {
      allow get, list: if isSelf(employeeUid) && myUserIsActive();

      allow create, update: if isSelf(employeeUid)
        && myUserIsActive()
        && request.resource.data.employeeId == myUid()
        && request.resource.data.storeId == storeId;

      allow delete: if false;
    }

    // ==================================
    // STORES ROOT
    // ==================================
    match /stores/{storeId} {
      allow get: if canReadStore(storeId, resource.data);
      allow list: if false;

      allow create: if activeManager()
        && request.resource.data.managerId == myUid()
        && request.resource.data.isActive == true;

      allow update: if activeManager()
        && resource.data.managerId == myUid()
        && request.resource.data.managerId == resource.data.managerId;

      allow delete: if activeManager()
        && resource.data.managerId == myUid();

      match /members/{uid} {
        allow get: if isSelf(uid)
          || (activeManager()
              && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid());

        allow list: if activeManager()
          && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid();

        allow create: if isSelf(uid)
          && request.resource.id == myUid()
          && request.resource.data.userId == myUid()
          && request.resource.data.storeId == storeId;

        allow update: if isSelf(uid)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.joinedAt == resource.data.joinedAt;

        allow delete: if false;
      }
    }

    // ==================================
    // CHECKINS ROOT
    // ==================================
    match /checkins/{checkinId} {

      function storeDocSafe(storeId) {
        return (storeId is string)
          && exists(/databases/$(database)/documents/stores/$(storeId));
      }

      allow get: if signedIn() && (
        resource.data.employeeId == myUid()
        || (
          activeManager()
          && (resource.data.storeId is string)
          && storeDocSafe(resource.data.storeId)
          && canReadStore(
            resource.data.storeId,
            get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data
          )
        )
      );

      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.employeeId == myUid()
        && (request.resource.data.storeId is string)
        && request.resource.data.photoRequired == true
        && request.resource.data.photoVersion == 1
        && (
          employeeAssignedToStore(request.resource.data.storeId)
          || isStoreMember(request.resource.data.storeId)
        );

      // ✅ CHANGE (minimal): employee can update their own (existing rules)
      // ✅ ADD (minimal): manager can update ONLY time fields (for stores they own)
      allow update: if (
          signedIn()
          && resource.data.employeeId == myUid()
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.checkInTime == resource.data.checkInTime
          && request.resource.data.createdAt == resource.data.createdAt
        )
        || managerEditsTimesOnly();

      // ✅ FIX (minimal): manager can delete ONLY if they own the store for this checkin
      // (keeps employee delete working)
      allow delete: if (signedIn() && resource.data.employeeId == myUid())
        || (isStoreManager(resource.data.storeId));
    }

    // ==================================
    // EMPLOYEE CHECKIN MIRROR
    // employeeCheckins/{employeeUid}/checkins/{checkinId}
    // ==================================
    match /employeeCheckins/{employeeUid}/checkins/{checkinId} {
      allow get, list: if isSelf(employeeUid) && myUserIsActive();

      allow create: if isSelf(employeeUid)
        && request.resource.data.employeeId == myUid()
        && (request.resource.data.storeId is string)
        && request.resource.data.photoRequired == true
        && request.resource.data.photoVersion == 1
        && (isStoreMember(request.resource.data.storeId) || employeeAssignedToStore(request.resource.data.storeId));

      // ✅ CHANGE (minimal): allow manager time edits on employee mirror too
      allow update: if (
          isSelf(employeeUid)
          && resource.data.employeeId == myUid()
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.checkInTime == resource.data.checkInTime
          && request.resource.data.createdAt == resource.data.createdAt
        )
        || (
          // manager edits times only, for stores they own
          activeManager()
          && (resource.data.storeId is string)
          && isStoreManager(resource.data.storeId)
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["checkInTime", "checkOutTime", "updatedAt"])
        );

      // ✅ FIX (minimal): allow manager to delete employee mirror ONLY for their store
      allow delete: if (isSelf(employeeUid) && myUserIsActive())
        || (activeManager()
            && (resource.data.storeId is string)
            && isStoreManager(resource.data.storeId));
    }

    // ==================================
    // MANAGER CHECKIN MIRROR
    // managerCheckins/{managerUid}/stores/{storeId}/checkins/{checkinId}
    // ==================================
    match /managerCheckins/{managerUid}/stores/{storeId}/checkins/{checkinId} {

      function storeExists(storeId) {
        return (storeId is string) && exists(/databases/$(database)/documents/stores/$(storeId));
      }

      function storeManagerMatches(managerUid, storeId) {
        return storeExists(storeId)
          && get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == managerUid;
      }

      allow get, list: if activeManager()
        && myUid() == managerUid
        && storeManagerMatches(managerUid, storeId);

      // (keeping your existing create/update rule as-is)
      allow create, update: if signedIn()
        && request.resource.data.employeeId == myUid()
        && (request.resource.data.storeId is string)
        && request.resource.data.photoRequired == true
        && request.resource.data.photoVersion == 1
        && request.resource.data.storeId == storeId
        && storeManagerMatches(managerUid, storeId)
        && (isStoreMember(storeId) || employeeAssignedToStore(storeId));

      // ✅ ADD (minimal): manager can update ONLY time fields in their mirror docs
      allow update: if (
          activeManager()
          && myUid() == managerUid
          && storeManagerMatches(managerUid, storeId)
          && request.resource.data.employeeId == resource.data.employeeId
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["checkInTime", "checkOutTime", "updatedAt"])
        )
        || (
          signedIn()
          && request.resource.data.employeeId == myUid()
          && (request.resource.data.storeId is string)
          && request.resource.data.storeId == storeId
          && storeManagerMatches(managerUid, storeId)
          && (isStoreMember(storeId) || employeeAssignedToStore(storeId))
        );

      // ✅ FIX (minimal): manager can delete their mirror docs (and employee can delete their own)
      allow delete: if (activeManager() && myUid() == managerUid)
        || (signedIn() && resource.data.employeeId == myUid());
    }
  }
}
