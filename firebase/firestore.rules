rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myUser() { return get(/databases/$(database)/documents/users/$(myUid())); }
    function manager() { return signedIn() && myUser().data.role == "manager"; }

    match /users/{uid} {
      allow read: if signedIn() && (uid == myUid() || manager());
      allow create: if signedIn() && uid == myUid();
      allow update: if signedIn() && (
        manager() ||
        (uid == myUid() && request.resource.data.role == resource.data.role)
      );
      allow delete: if manager();
    }

    match /stores/{storeId} {
      allow read: if signedIn();
      allow create, update, delete: if manager();
    }

    match /checkins/{checkinId} {
      allow read: if manager() || (signedIn() && resource.data.employeeId == myUid());
      allow create: if signedIn() && request.resource.data.employeeId == myUid();
      allow update, delete: if manager();
    }
  }
}
