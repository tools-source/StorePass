rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function requestUserDoc() {
      return userDoc(request.auth.uid);
    }

    function isManager() {
      return isSignedIn() && requestUserDoc().data.role == "manager";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isManager();
      allow create: if isOwner(uid) && request.resource.data.role in ["employee", "manager"];
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.id == resource.data.id
        || isManager();
      allow delete: if isManager();
    }

    match /stores/{storeId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /checkins/{checkinId} {
      allow read: if isManager() || (isSignedIn() && resource.data.employeeId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.employeeId == request.auth.uid;
      allow update, delete: if isManager();
    }

    // Example manager-only collections.
    match /managerReports/{docId} {
      allow read, write: if isManager();
    }

    match /managerAnnouncements/{docId} {
      allow read, write: if isManager();
    }
  }
}
