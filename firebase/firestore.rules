rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(myUid());
    }

    // Safe to call even when user doc may not exist.
    function myUserExists() {
      return signedIn() && exists(myUserPath());
    }

    function myUserRoleIsManager() {
      return myUserExists() && get(myUserPath()).data.role == "manager";
    }

    function myUserIsActive() {
      return myUserExists() && get(myUserPath()).data.isActive == true;
    }

    function isManager() {
      return myUserRoleIsManager() && myUserIsActive();
    }

    function isSelf(uid) {
      return signedIn() && uid == myUid();
    }

    function storePath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }

    function storeExists(storeId) {
      return exists(storePath(storeId));
    }

    function storeOwnerUid(storeId) {
      return get(storePath(storeId)).data.managerId;
    }

    function isStoreOwner(storeId) {
      return signedIn() && storeExists(storeId) && storeOwnerUid(storeId) == myUid();
    }

    function managerOwnsCheckin(data) {
      return isManager()
        && data.storeId is string
        && isStoreOwner(data.storeId);
    }

    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid) && request.resource.data.role == "employee";
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.assignedStoreIds == resource.data.assignedStoreIds;
      allow delete: if isSelf(uid);
    }

    match /stores/{storeId} {
      allow get, list: if signedIn();
      allow create: if isManager() && request.resource.data.managerId == myUid();
      allow update, delete: if isStoreOwner(storeId)
        && request.resource.data.managerId == resource.data.managerId;
    }

    match /storeMembers/{storeId}/members/{uid} {
      allow get: if isSelf(uid) || isStoreOwner(storeId);
      allow list: if isStoreOwner(storeId);
      allow create, update, delete: if false;
    }

    match /checkins/{checkinId} {
      allow get: if (signedIn() && resource.data.employeeId == myUid())
        || managerOwnsCheckin(resource.data);
      allow list: if (signedIn() && resource.data.employeeId == myUid())
        || managerOwnsCheckin(resource.data);
      allow create: if signedIn() && request.resource.data.employeeId == myUid();
      allow update: if false;
      allow delete: if managerOwnsCheckin(resource.data);
    }
  }
}
