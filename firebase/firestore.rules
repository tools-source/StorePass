rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myUserPath() { return /databases/$(database)/documents/users/$(myUid()); }
    function myUser() { return get(myUserPath()); }
    function isManager() {
      return signedIn() &&
        exists(myUserPath()) &&
        myUser().data.role == "manager" &&
        myUser().data.isActive == true;
    }
    function managerEmployeePath(managerId, employeeId) {
      return /databases/$(database)/documents/managers/$(managerId)/employees/$(employeeId);
    }
    function isLinkedEmployee(employeeId) {
      return signedIn() && isManager() && exists(managerEmployeePath(myUid(), employeeId));
    }

    match /users/{uid} {
      allow get: if signedIn() && (uid == myUid() || isLinkedEmployee(uid));
      allow list: if false;

      allow create: if signedIn() && uid == myUid() &&
        request.resource.data.role == "employee" &&
        request.resource.data.isActive == true;

      allow update: if signedIn() && (
        (uid == myUid() &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.createdByManagerId == resource.data.createdByManagerId
        ) ||
        (isLinkedEmployee(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.createdByManagerId == resource.data.createdByManagerId
        )
      );

      allow delete: if false;
    }

    match /managers/{managerId}/employees/{employeeId} {
      allow get, list: if signedIn() && managerId == myUid() && isManager();
      allow create, update: if signedIn() && managerId == myUid() && isManager() &&
        request.resource.data.employeeUserId == employeeId;
      allow delete: if signedIn() && managerId == myUid() && isManager();
    }

    match /stores/{storeId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isManager();
    }

    match /checkins/{checkinId} {
      allow get: if isManager() || (signedIn() && resource.data.employeeId == myUid());
      allow list: if isManager();

      allow create: if signedIn() && (
        isManager() ||
        request.resource.data.employeeId == myUid()
      );

      allow update, delete: if isManager();
    }
  }
}
