rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myUserPath() { return /databases/$(database)/documents/users/$(myUid()); }
    function myUser() { return get(myUserPath()); }
    function isManager() {
      return signedIn() &&
        exists(myUserPath()) &&
        myUser().data.role == "manager";
    }

    match /users/{uid} {
      allow get: if signedIn() && (uid == myUid() || isManager());
      allow list: if isManager();

      allow create: if signedIn() && (
        isManager() ||
        (
          uid == myUid() &&
          request.resource.data.role == "employee" &&
          request.resource.data.isActive == true
        )
      );

      allow update: if signedIn() && (
        isManager() ||
        (
          uid == myUid() &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isActive == resource.data.isActive
        )
      );

      allow delete: if isManager();
    }

    match /stores/{storeId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isManager();
    }

    match /checkins/{checkinId} {
      allow get: if isManager() || (signedIn() && resource.data.employeeId == myUid());
      allow list: if isManager();

      allow create: if signedIn() && (
        isManager() ||
        request.resource.data.employeeId == myUid()
      );

      allow update, delete: if isManager();
    }
  }
}
