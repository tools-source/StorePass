rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myUserPath() { return /databases/$(database)/documents/users/$(myUid()); }
    function myUser() { return get(myUserPath()); }
    function isSelf(uid) { return signedIn() && uid == myUid(); }
    function isManager() {
      return signedIn() && exists(myUserPath()) && myUser().data.role == "manager" && myUser().data.isActive == true;
    }
    function isStoreOwner(storeId) {
      return isManager() &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        get(/databases/$(database)/documents/stores/$(storeId)).data.managerId == myUid();
    }

    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid) && request.resource.data.role == "employee";
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.assignedStoreIds == resource.data.assignedStoreIds;
      allow delete: if isSelf(uid);
    }

    match /stores/{storeId} {
      allow get: if signedIn() && (
        resource.data.managerId == myUid() ||
        exists(/databases/$(database)/documents/storeMembers/$(storeId)/members/$(myUid()))
      );
      allow list: if signedIn();
      allow create: if isManager() && request.resource.data.managerId == myUid();
      allow update, delete: if isStoreOwner(storeId)
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /storeMembers/{storeId}/members/{uid} {
      allow get: if isSelf(uid) || isStoreOwner(storeId);
      allow list: if isStoreOwner(storeId);
      allow create, update, delete: if false;
    }

    match /checkins/{checkinId} {
      allow get: if isManager() || (signedIn() && resource.data.employeeId == myUid());
      allow list: if isManager();
      allow create: if signedIn() && request.resource.data.employeeId == myUid();
      allow update, delete: if isManager();
    }
  }
}
