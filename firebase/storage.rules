rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function isActiveEmployee(uid) {
      return signedIn()
        && userDoc(uid).data.role == "employee"
        && userDoc(uid).data.isActive == true;
    }

    function isStoreMember(uid, storeId) {
      return firestore.exists(/databases/(default)/documents/stores/$(storeId)/members/$(uid))
        || firestore.exists(/databases/(default)/documents/employeeStores/$(uid)/stores/$(storeId));
    }

    function isStoreManager(storeId) {
      return signedIn()
        && userDoc(myUid()).data.role == "manager"
        && userDoc(myUid()).data.isActive == true
        && firestore.exists(/databases/(default)/documents/stores/$(storeId))
        && firestore.get(/databases/(default)/documents/stores/$(storeId)).data.managerId == myUid();
    }

    match /checkinPhotos/{storeId}/{employeeId}/{checkinId}/{fileName} {
      allow write: if signedIn()
        && employeeId == myUid()
        && isActiveEmployee(employeeId)
        && isStoreMember(employeeId, storeId)
        && (fileName == "checkin.jpg" || fileName == "checkout.jpg");

      allow read: if signedIn() && (
        employeeId == myUid()
        || isStoreManager(storeId)
      );
    }
  }
}
